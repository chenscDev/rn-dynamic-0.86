{
  "provider": "local",
  "baseUrl": "http://47.93.207.70/cdn",
  "targetDir": "project/dist/cdn-local",
  "pathTemplate": "rn/{rnVersion}/{channel}/{key}/{platform}/{fileName}",
  "defaultChannel": "agent-docx",
  "keepHistory": 5,
  "cdn": {
    "endpoint": "oss-cn-hangzhou.aliyuncs.com",
    "bucket": "rn-bundles",
    "region": "oss-cn-hangzhou",
    "accessKeyEnv": "OSS_ACCESS_KEY_ID",
    "secretKeyEnv": "OSS_ACCESS_KEY_SECRET",
    "comment": "演示期 local+rsync；baseUrl 指向公网 CDN 以开启无感热更"
  }
}
